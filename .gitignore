# Dependencies (installed on demand by /design-setup)
node_modules/
package-lock.json

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Scratch / generated output (pages, shots, assets are written to /tmp at runtime)
/tmp/
*.log
.write-test

# anti-ai-eval / brand-lint run artifacts — they embed the scanned page's own copy
anti-ai-report.json
brand-lint.json

# Internal autopilot orchestration artifacts (local only — not part of the published plugin)
docs/autopilot/
docs/LEDGER-autopilot-*.md
docs/ROADMAP-autopilot-*.md
docs/goals/
anti-ai-report.json

# v2 session artifacts (local only — never part of the published plugin).
# Tracked docs/LEDGER.md and docs/CHANGELOG.md are unaffected (patterns require the hyphen);
# docs/goals/ above already covers docs/goals/evidence/.
out/
docs/LEDGER-*.md
docs/ROADMAP-*.md
docs/ANALYSIS-*.md
# Chromium/Chrome profile residue inside capture dirs (cookie DBs, telemetry,
# hostname-leaking singleton symlinks) — regenerated on every headed capture run;
# never publishable (red-team H-02, 2026-07-19).
**/.profile_*/

# v3 staging root and the raw capture fleet it was built from (local only — never part of the
# published plugin). Approved by the owner as an accidental-commit guard, card
# visigner/2026-07-24/002. `v3/` holds the Movements catalog/composer while it is still staging;
# `/references/` is the repo-root raw fleet (891M on disk, mostly Chromium residue and full-page
# tiles). Corpus records promoted into the plugin live under
# skills/detail-page/references/corpus/ and are unaffected by these patterns.
v3/
/references/

# The composer's own build outputs. Every run directory ships its brief.json and selection.json —
# the two inputs — and page.html is what `node scripts/composer-run.js <brief> <run>` regenerates
# from them. Committing the output would let a stale page.html disagree with the inputs beside it,
# which is the exact drift the deterministic assembler exists to rule out.
skills/detail-page/factory/composer/*/page.html
